# ==============================================================================
# VerityAI - Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# Note: Never commit your actual .env file or sensitive keys to version control.
# ==============================================================================

# Application Environment (development, testing, production)
VERITY_ENV=development

# Streamlit Server Configuration
VERITY_HOST=localhost
VERITY_PORT=8501

# System & Research Assistant Defaults
VERITY_APP_NAME=VerityAI
VERITY_OFFLINE_MODE=true
VERITY_LOG_LEVEL=INFO

# Future Storage Paths (Relative to project root)
# VERITY_DATA_DIR=./data
# VERITY_MODELS_DIR=./models
